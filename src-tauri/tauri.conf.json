{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finança Simples",
  "version": "1.4.0",
  "identifier": "br.com.financasimples.desktop",
  "build": {
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Finança Simples",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "theme": "Dark",
        "backgroundColor": "#07120f",
        "devtools": false,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "capabilities": [],
      "csp": null,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": false,
    "category": "Finance",
    "shortDescription": "Controle financeiro local para Windows",
    "longDescription": "Finança Simples para Windows baseado na planilha Finança Simples - Essencial 2025, com saídas, entradas, cartões, parcelas, faturas, resumo anual, investimentos, parametrização e SQLite local.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["PortugueseBR"]
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
