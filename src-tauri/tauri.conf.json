{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finança Simples",
  "version": "1.7.0",
  "identifier": "br.com.financasimples.desktop",
  "build": {
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Finança Simples",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "theme": "Dark",
        "backgroundColor": "#07120f",
        "devtools": false,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "capabilities": [],
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.supabase.co",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'self'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": false,
    "category": "Finance",
    "shortDescription": "Gestão financeira multiusuário para Windows",
    "longDescription": "Finança Simples para Windows com os recursos da planilha Essencial 2025, autenticação, ambientes isolados, sincronização offline-first, Open Finance, investimentos, metas, indicadores do Banco Central, agente Aurora, simuladores, backup e atualização assinada quando habilitada.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["PortugueseBR"]
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
